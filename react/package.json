{
  "name": "@browserkit/react",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/browser.js",
  "module": "./dist/browser.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/browser.js"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json && cp src/style.css dist/style.css",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.6",
    "vitest": "^4.1.11",
    "jsdom": "^26.1.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/jest-dom": "^6.6.3"
  },
  "description": "React browser controls for BrowserKit: tabs, live view, input and diagnostics",
  "keywords": [
    "browser",
    "react",
    "chrome",
    "cdp",
    "automation"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeoxisca/awesome-browserkit.git",
    "directory": "react"
  },
  "homepage": "https://github.com/zeoxisca/awesome-browserkit/tree/main/react",
  "bugs": {
    "url": "https://github.com/zeoxisca/awesome-browserkit/issues"
  }
}
